# Copy to .env (git-ignored). `docker compose` reads it automatically.

# JWT signing secret. REQUIRED: compose and the backend refuse to start without
# a strong value (at least 32 characters, not a placeholder). Generate one with:
#   openssl rand -hex 32
# Changing it later signs every user out (existing tokens become invalid).
SECRET=

# First administrator, created on startup only while no superuser exists, and
# only when BOTH are set (password: at least 12 characters). Remove
# FIRST_ADMIN_PASSWORD from this file after the first successful start.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# hCaptcha (optional)
# HCAPTCHA_ENABLED=true
# HCAPTCHA_SECRET=
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
